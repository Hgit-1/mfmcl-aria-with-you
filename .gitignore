# Build output: reproducible from the sources, so it is not versioned.
dist/

# Python bytecode from tools/
__pycache__/
*.pyc

# Image generation key. Belongs in the environment, never in the repository —
# the same rule the launcher applies to its CurseForge key.
.env
.env.*

# Audit output: contact sheets and the JSON report are regenerated by
# `python tools/audit.py` and describe a run, not a source.
out/
design/tools/aria/out/

# OS noise
.DS_Store
Thumbs.db
